{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/validate-files.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-dangerous-commands.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allowByDefault": [],
    "prompt": [
      "Read",
      "Bash",
      "Edit",
      "Write"
    ]
  }
}
